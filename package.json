{
  "name": "@ljwei-stak/model-router-galgame",
  "version": "0.4.25",
  "type": "module",
  "description": "DeepSeek Harness plugin: adaptive model routing, cost analysis and GAL view",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljwei-stak/model-router-galgame.git"
  },
  "homepage": "https://github.com/ljwei-stak/model-router-galgame#readme",
  "bugs": {
    "url": "https://github.com/ljwei-stak/model-router-galgame/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": "./.dsh-plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "sessions",
        "modelDirectories",
        "conversation",
        "connection",
        "remote",
        "remote.session"
      ]
    }
  },
  "files": [
    ".dsh-plugin/index.mjs",
    ".dsh-plugin/client.js",
    ".dsh-plugin/shared/**/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "INSTALLATION_GUIDE.zh.md",
    "GAL_GAME_CONCEPT.zh.md",
    "GAL_GAME_PREVIEW.md",
    "MODLENS_DEPLOYMENT.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "preview:gal": "node scripts/gal-preview.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@liustack/modlens": "3.25.4",
    "@liustack/modsearch": "5.10.1",
    "@ljwei-stak/dsh-approval-gate": "0.5.3",
    "schemastery": "3.18.0",
    "@ljwei-stak/dsh-ego-browser": "0.8.3",
    "@ljwei-stak/ppt-master-for-mgr": "6.3.2",
    "@ljwei-stak/dsh-watcher-for-mrg": "0.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1 || ^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-stats": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.41.0",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
